JALDRISHTI_ENVIRONMENT=development
JALDRISHTI_DATABASE_URL=postgresql+asyncpg://jaldrishti:jaldrishti@postgres:5432/jaldrishti
JALDRISHTI_REDIS_URL=redis://redis:6379/0
JALDRISHTI_LOG_LEVEL=INFO
JALDRISHTI_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
WEB_HOST_PORT=8080

POSTGRES_DB=jaldrishti
POSTGRES_USER=jaldrishti
POSTGRES_PASSWORD=jaldrishti

VITE_API_BASE_URL=/api/v1

# Development-only key for encrypting optional incident contact details.
# Generate and inject a different Fernet key in every deployed environment.
JALDRISHTI_CONTACT_ENCRYPTION_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
JALDRISHTI_CONTACT_ENCRYPTION_KEY_ID=development-only-v1
JALDRISHTI_INCIDENT_RATE_LIMIT_PER_HOUR=10
JALDRISHTI_INCIDENT_MEDIA_MAX_BYTES=8388608

# Optional Phase 6 download credentials. Public ASF catalogue discovery works
# without them; OPERA RTC asset downloads require an Earthdata account and
# accepted ASF terms. Prefer a short-lived token when available.
EARTHDATA_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
